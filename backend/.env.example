# ---------------------------------------------------------------------------
# DanyPathMart backend environment (example)
# Copy to .env and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# App
APP_ENV=dev
APP_URL=http://localhost:8000
ADMIN_EMAIL=admin@danypathmart.store
# Local only — auto-login as admin (blocked when APP_ENV=production). MUST be 0 in prod — see .env.production.example
DEV_ADMIN_BYPASS=1
DEV_ADMIN_EMAIL=admin@danypathmart.store
CORS_ORIGIN=http://localhost:5173

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=danypathmart
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=change_this_to_a_long_random_256_bit_value
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# Paystack (leave secret as the placeholder in dev to use the mock pay flow)
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_960a3adea6c75c392b030a5e6626648f11079e5f

# Google Vision
GOOGLE_VISION_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxx

# SMTP (leave SMTP_HOST blank in dev to dump emails to storage/mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=noreply@danypathmart.store
SMTP_PASS=
SMTP_FROM_NAME=DanyPathMart

# Error monitoring (optional — P5 launch readiness warns if unset in production)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# WebAuthn — DEV (local)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=DanyPathMart
WEBAUTHN_ORIGIN=http://localhost:5173

# WebAuthn — PRODUCTION (uncomment on Hostinger; domain must match exactly)
# WEBAUTHN_RP_ID=danypathmart.store
# WEBAUTHN_RP_NAME=DanyPathMart
# WEBAUTHN_ORIGIN=https://danypathmart.store
# APP_ENV=production
# APP_URL=https://danypathmart.store/api
# CORS_ORIGIN=https://danypathmart.store

# ---------------------------------------------------------------------------
# Social sign-in (Google, Microsoft, Apple)
# Redirect URIs must match APP_URL + /auth/oauth/{provider}/callback
# ---------------------------------------------------------------------------

# Google — https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft — Azure App registration
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# Apple — Services ID + Sign in with Apple key (.p8)
APPLE_OAUTH_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Or path to .p8 file instead of APPLE_PRIVATE_KEY:
# APPLE_PRIVATE_KEY_PATH=
