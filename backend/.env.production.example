# ---------------------------------------------------------------------------
# DanyPathMart — PRODUCTION backend (.env)
# Copy to public_html/api/.env on Hostinger. NEVER commit the real file.
# ---------------------------------------------------------------------------

APP_ENV=production
APP_URL=https://danypathmart.store/api
CORS_ORIGIN=https://danypathmart.store
ADMIN_EMAIL=admin@danypathmart.store

# MUST be off in production (dev auto-login is blocked when APP_ENV=production anyway)
DEV_ADMIN_BYPASS=0

DB_HOST=localhost
DB_PORT=3306
DB_NAME=danypathmart
DB_USER=your_db_user
DB_PASS=your_db_password

# Generate: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

GOOGLE_VISION_API_KEY=

# --- Email: Gmail SMTP (recommended if you use a Google account) ---
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=you@gmail.com
SMTP_FROM_EMAIL=you@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM_NAME=DanyPathMart

# --- Email: Hostinger mailbox (alternative) ---
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_ENCRYPTION=tls
# SMTP_USER=noreply@danypathmart.store
# SMTP_FROM_EMAIL=noreply@danypathmart.store
# SMTP_PASS=

WEBAUTHN_RP_ID=danypathmart.store
WEBAUTHN_RP_NAME=DanyPathMart
WEBAUTHN_ORIGIN=https://danypathmart.store

# OAuth (optional) — redirect URIs: https://danypathmart.store/api/auth/oauth/{provider}/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
APPLE_OAUTH_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Push — public key in Admin → Company settings → Messaging & push
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@danypathmart.store

# Universal SMS (any HTTP provider — configure URL + key when ready)
SMS_API_URL=
SMS_API_KEY=
SMS_API_METHOD=POST
SMS_DEFAULT_COUNTRY_CODE=233

# Universal WhatsApp
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_API_METHOD=POST
